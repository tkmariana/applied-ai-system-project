%% PawPal Assistant: what happens to one request, step by step
%% Green = human involvement, blue = automated testing of this flow.
flowchart TD
    U(["Family member asks:<br/>'Add a 20 minute walk for Rex at 07:30'"]) --> S["1. sanitize_user_prompt<br/>length, control chars, prompt injection"]
    S -->|blocked| R1["Refusal message<br/>nothing is sent to the model"]
    S --> SC["2. check_scope<br/>pet care only, no diagnosis or doses"]
    SC -->|blocked| R1
    SC --> A["3. Agent loop (Gemini, max 8 steps)<br/>plan, call a tool, read result, repeat"]

    A <-->|"care question: retrieve before answering"| RAG["search_care_guide<br/>TF-IDF over data/knowledge"]
    A <-->|"look at the schedule"| SCHED["list_tasks, check_conflicts, next_free_slot"]
    A -->|"act"| ACT["add_task, add_pet, complete_task"]

    ACT --> V["4. Validate with guardrails<br/>fields, known pet and member, time budget, duplicates"]
    V -->|"invalid: reason returned to the model,<br/>so it can fix the request or tell the user"| A
    V --> MODE{"Assistant switch"}
    MODE -->|"ON: apply now"| AP["apply_proposal<br/>re-validates, changes the household"]
    MODE -->|"OFF: proposal only"| H["Human approves or rejects"]
    H -->|Approve| AP
    H -->|Reject| ANS
    AP --> LOG["Changes listed in the UI,<br/>toast notification"]
    A -->|"final answer, based on retrieved text"| ANS["5. Answer shown to the family<br/>(brief, no source line)"]
    LOG --> ANS

    A -.-> L[("logs/pawpal.log")]
    V -.-> L

    T1["pytest: agent tests with a scripted fake model"] -.-> A
    T2["evals/run.py: retrieval, consistency,<br/>guardrails, agent actions"] -.-> V

    classDef human fill:#DDF7EE,stroke:#2FB380,color:#0F5C42;
    classDef test fill:#E3F1FF,stroke:#3B82F6,color:#1D4ED8;
    class U,MODE,H,ANS human;
    class T1,T2 test;
